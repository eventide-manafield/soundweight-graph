<Window x:Class="SoundWeightGraph.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
 Title="SoundWeight Graph" Width="1240" Height="820" MinWidth="960" MinHeight="640" Background="#F5F7FB" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" AllowDrop="True" Drop="FileDropped" DragOver="FileDragOver" Closing="WindowClosing">
 <Grid Margin="24" Background="#F5F7FB">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel><TextBlock Text="SoundWeight Graph" FontSize="13" FontWeight="Bold" Foreground="#3470D8"/><TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,9,0,5" TextTrimming="CharacterEllipsis" MaxWidth="850" HorizontalAlignment="Left"/><TextBlock Text="{Binding Subtitle}" Foreground="#64748B"/></StackPanel>
   <Button Content="오픈소스 고지" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ShowNotices"/>
  </Grid>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,18">
   <Button Content="MP4 파일 선택" Click="ChooseFile" Background="#DCEAFF" FontWeight="SemiBold"/>
   <Button Content="분석 시작" Command="{Binding AnalyzeCommand}"/>
   <Button Content="취소" Command="{Binding CancelCommand}"/>
   <Button Content="캐시 지우기" Command="{Binding ClearCacheCommand}"/>
   <TextBlock Text="파일을 창에 끌어다 놓아도 돼요" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#64748B"/>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="오디오 트랙" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="사용 여부와 가중치를 조절해 봐" Foreground="#64748B" Margin="0,5,0,0"/></StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Tracks}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,10,0,14" Margin="0,0,0,5">
         <StackPanel>
          <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Details}" Foreground="#64748B" FontSize="11" Margin="0,6,0,4"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
           <Slider Minimum="0" Maximum="3" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding Weight}" VerticalAlignment="Center" AutomationProperties.Name="트랙 가중치"/>
           <TextBlock Grid.Column="1" Text="{Binding Weight, StringFormat={}{0:F2} ×}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <ComboBox SelectedValue="{Binding Kind}" SelectedValuePath="Tag" Margin="0,6,0,5" AutomationProperties.Name="트랙 역할">
           <ComboBoxItem Content="유형 미지정" Tag="Unknown"/><ComboBoxItem Content="개별 소스" Tag="Independent"/><ComboBoxItem Content="전체 믹스" Tag="Mix"/>
          </ComboBox>
          <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#475569"/>
          <TextBlock Text="{Binding MixHint}" FontSize="11" Foreground="#986419" TextWrapping="Wrap" Margin="0,4,0,0"/>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><StackPanel><TextBlock Text="하이라이트 후보 점수" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="소리 변화와 여러 트랙의 반응이 모이는 정도 · 0–100" Foreground="#64748B" Margin="0,5,0,0"/></StackPanel><Button Content="전체 보기" HorizontalAlignment="Right" VerticalAlignment="Top" Click="FitPlot"/></Grid>
     <sp:WpfPlot x:Name="Chart" Grid.Row="1" Margin="0,18,0,10" PreviewMouseMove="PlotMouseMove" PreviewMouseLeftButtonDown="PlotMouseDown" PreviewMouseLeftButtonUp="PlotMouseUp"/>
     <StackPanel Grid.Row="2"><TextBlock Text="{Binding Cursor}" FontFamily="Consolas, Malgun Gothic"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="선택 시각" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Text="{Binding SelectedTime, Mode=OneWay}" IsReadOnly="True" Width="145" Padding="8,6" FontFamily="Consolas"/><Button Content="시각 복사" Click="CopyTime" Margin="10,0,0,0"/></StackPanel></StackPanel>
     <TextBlock Grid.Row="3" Text="휠로 가로 확대 · Shift+휠/드래그로 좌우 이동 · 클릭으로 시각 선택&#10;후보 점수는 장면의 재미나 편집 품질을 판단하지 않아요." TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,16,0,0"/>
    </Grid>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,18,0,0"><ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="5" Maximum="100" Foreground="#3470D8"/><TextBlock Text="{Binding Status}" Margin="0,9,0,0"/><TextBlock Text="{Binding Warning}" Foreground="#A25912" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
 </Grid>
</Window>

