<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><UseWPF>true</UseWPF>
    <AssemblyName>SoundWeightGraph</AssemblyName><Version>0.1.0</Version>
    <AssemblyTitle>SoundWeight Graph</AssemblyTitle>
    <Description>SoundWeight Graph - multitrack audio activity analysis</Description>
    <PublishTrimmed>false</PublishTrimmed><DebugType>embedded</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="10.0.11" />
    <FrameworkReference Update="Microsoft.WindowsDesktop.App.WPF" RuntimeFrameworkVersion="10.0.11" />
    <ProjectReference Include="../SoundWeightGraph.Core/SoundWeightGraph.Core.csproj" />
    <ProjectReference Include="../SoundWeightGraph.Infrastructure/SoundWeightGraph.Infrastructure.csproj" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>
</Project>
